---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const traditionalJewelerUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.salesOfficers[0].phone,
  "Assalam-o-Alaikum, I am a jeweler inquiring about bulk supply and wholesale catalog orders from Soobee's Box."
);

const ecommerceBrandUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.salesOfficers[2].phone,
  "Assalam-o-Alaikum, I run an online jewelry/watch brand and want to discuss custom branded packaging and unboxing presentation."
);
---

<section class="audience-section section-spacing" aria-label="Solutions Tailored to Your Business Model">
  <div class="container">
    <div class="section-intro animate-in">
      <p class="section-eyebrow">Tailored Wholesale Solutions</p>
      <h2>Designed for How You Sell</h2>
      <p class="section-lead">
        Whether you run a high-volume gold market showroom or a modern D2C ecommerce brand, Soobee's Box aligns with your supply chain and branding priorities.
      </p>
    </div>

    <!-- Asymmetric 3fr / 2fr grid -->
    <div class="audience-grid">

      <!-- Card 1 (wider): Traditional Jeweler — light -->
      <div class="audience-card audience-card-light card-lift animate-in stagger-1 from-left">
        <div class="card-tag card-tag-light">For Traditional Jewelers &amp; Wholesalers</div>
        <h3>One Supplier for All Your Jewelry &amp; Watch Boxes</h3>
        <p class="card-desc">
          Simplify procurement. Instead of coordinating with multiple box traders across different markets, order your entire range from our Karachi manufacturing base — from ring foam boxes and multi-bangle bridal cases to watch packaging, all under one invoice.
        </p>

        <div class="priority-block priority-block-light">
          <p class="priority-title">What matters to you:</p>
          <ul class="priority-list">
            <li>
              <svg class="check-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Complete catalogue breadth under one invoice
            </li>
            <li>
              <svg class="check-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Wholesale factory pricing with bulk capacity
            </li>
            <li>
              <svg class="check-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Cross-category convenience: add watch packaging to existing jewelry orders
            </li>
          </ul>
        </div>

        <a
          href={traditionalJewelerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary audience-cta"
        >
          <span>Inquire as Traditional Jeweler</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Card 2 (narrower): D2C Brand — dark inverse -->
      <div class="audience-card audience-card-dark card-lift animate-in stagger-2">
        <div class="card-tag card-tag-dark">For Online Brands &amp; Boutique Retailers</div>
        <h3 class="dark-heading">Branded Packaging That Converts Unboxing Into Marketing</h3>
        <p class="card-desc dark-desc">
          For D2C jewelry and watch brands competing on presentation, we provide custom logo-embossed velvet boxes at factory-direct pricing. Lower minimums on branded runs available for emerging ecommerce labels.
        </p>

        <div class="priority-block priority-block-dark">
          <p class="priority-title priority-title-dark">What matters to you:</p>
          <ul class="priority-list priority-list-dark">
            <li>
              <svg class="check-icon check-icon-gold" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Logo embossing with sharp metallic foil definition
            </li>
            <li>
              <svg class="check-icon check-icon-gold" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Consistent quality every production run
            </li>
            <li>
              <svg class="check-icon check-icon-gold" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Packaging that photographs well and ships safely
            </li>
          </ul>
        </div>

        <a
          href={ecommerceBrandUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn watch-btn audience-cta"
        >
          <span>Inquire for Branded Packaging</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .audience-section {
    background-color: var(--bg-surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-intro {
    max-width: 600px;
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 0.875rem;
  }

  .section-intro h2 {
    margin-bottom: 1rem;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  /* Asymmetric 3fr / 2fr */
  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .audience-grid {
      grid-template-columns: 3fr 2fr;
      align-items: stretch;
    }
  }

  /* Shared card base */
  .audience-card {
    border-radius: 16px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  /* Light card */
  .audience-card-light {
    background-color: var(--bg-surface);
    border: 1.5px solid var(--border-subtle);
  }

  .audience-card-light:hover {
    border-color: var(--accent-gold-border);
  }

  /* Dark inverse card */
  .audience-card-dark {
    background-color: var(--velvet-navy);
    border: 1.5px solid rgba(229, 195, 122, 0.1);
  }

  [data-theme="dark"] .audience-card-dark {
    background-color: #080D1A;
    border-color: rgba(229, 195, 122, 0.12);
  }

  .audience-card-dark:hover {
    border-color: rgba(229, 195, 122, 0.25);
  }

  /* Tags */
  .card-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border-radius: 100px;
    padding: 0.3rem 0.75rem;
    display: inline-block;
    align-self: flex-start;
  }

  .card-tag-light {
    color: var(--accent-gold-text);
    background-color: var(--accent-gold-soft);
    border: 1px solid var(--accent-gold-border);
  }

  .card-tag-dark {
    color: rgba(229, 195, 122, 0.85);
    background-color: rgba(229, 195, 122, 0.08);
    border: 1px solid rgba(229, 195, 122, 0.18);
  }

  .audience-card-light h3 {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    color: var(--text-primary);
  }

  .dark-heading {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    color: #F0EDE8;
  }

  .card-desc {
    font-size: 0.9375rem;
    line-height: 1.68;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .dark-desc {
    color: rgba(255, 255, 255, 0.45);
  }

  /* Priority blocks */
  .priority-block {
    border-radius: 10px;
    padding: 1.125rem 1.25rem;
  }

  .priority-block-light {
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
  }

  .priority-block-dark {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(229, 195, 122, 0.1);
  }

  .priority-title {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .priority-title-dark {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Lists with SVG check icons */
  .priority-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .priority-list li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    line-height: 1.45;
  }

  .priority-list-dark li {
    color: rgba(255, 255, 255, 0.55);
  }

  .check-icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .check-icon-gold {
    color: #E5C37A;
  }

  /* CTA buttons */
  .audience-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  /* Reuse watch-btn style from WatchCallout for the dark card */
  .watch-btn {
    background-color: #E5C37A;
    color: #0A0906;
    border: none;
    font-weight: 700;
    transition: all var(--duration-normal) var(--ease-spring);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    border-radius: 6px;
    cursor: pointer;
    min-height: 44px;
  }

  .watch-btn:hover {
    background-color: #F5DFA0;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px rgba(229, 195, 122, 0.2);
  }
</style>
