---
import { BUSINESS_INFO } from '../data/products';
---

<section class="pillars-section section-spacing" aria-label="Core Manufacturing Pillars">
  <div class="container">
    <div class="section-intro animate-in">
      <span class="badge badge-gold">The Soobee’s Box Advantage</span>
      <h2 class="section-title">Built for Every Piece You Sell</h2>
      <p class="section-subtitle">
        We eliminate the fragmentation of sourcing packaging from multiple third parties. By combining direct factory manufacturing in Karachi with in-house custom branding, we deliver consistency, speed, and distinct brand identity.
      </p>
    </div>

    <!-- Asymmetric 2+1 Layout -->
    <div class="pillars-grid">
      <!-- Top Row - Pillar 1: Direct Manufacturer (58%) -->
      <div class="pillar-card pillar-factory surface-card animate-in stagger-1">
        <div class="pillar-card-content">
          <div class="pillar-tag">Pillar 01 • Karachi Direct</div>
          <h3 class="pillar-heading">Manufacturer, Not Just a Middleman</h3>
          <p class="pillar-text">
            Operating directly from Karachi’s industrial S.I.T.E. Area, Soobee’s Box manufactures and distributes packaging directly. Retailers and ecommerce brands bypass intermediate reseller markups, gain direct production oversight, and enjoy reliable wholesale fulfillment.
          </p>
          <ul class="pillar-list">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Direct factory wholesale pricing structures</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Consistent velvet finishing and structural durability</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Karachi S.I.T.E. factory pickup and dispatch across Pakistan</span>
            </li>
          </ul>
        </div>
        <div class="pillar-accent-graphic factory-graphic" aria-hidden="true">
          <div class="blueprint-line"></div>
          <span class="facility-code">S.I.T.E. / KHI-IND</span>
        </div>
      </div>

      <!-- Top Row - Pillar 2: Complete Catalogue (42%) -->
      <div class="pillar-card pillar-catalogue surface-card animate-in stagger-2">
        <div class="pillar-card-content">
          <div class="pillar-tag">Pillar 02 • Single Source</div>
          <h3 class="pillar-heading">One Supplier. Every Box Category.</h3>
          <p class="pillar-text">
            No more splitting your packaging orders between different merchants. From single rings and coins to multi-bangle wedding sets and watches, consolidate your entire packaging supply into one trusted vendor.
          </p>
          <div class="category-pills">
            <span class="cat-pill">Rings & Bands</span>
            <span class="cat-pill">Studs & Jhumkas</span>
            <span class="cat-pill">Lockets & Sets</span>
            <span class="cat-pill">2/4/6 Bangles</span>
            <span class="cat-pill">Gold Coins</span>
            <span class="cat-pill">Necklace Chains</span>
            <span class="cat-pill">Full Watch Boxes</span>
          </div>
        </div>
      </div>

      <!-- Bottom Row - Pillar 3: Full-Width Custom Embossing Callout -->
      <div class="pillar-callout surface-card animate-in stagger-3">
        <div class="callout-grid">
          <div class="callout-text-col">
            <div class="pillar-tag">Pillar 03 • Brand Differentiator</div>
            <h3 class="callout-heading">Your Logo. Our Craftsmanship.</h3>
            <p class="callout-body">
              Packaging should carry <em>your</em> brand, not generic stock labels. We provide custom metallic foil logo embossing directly onto our velvet boxes. Your customers experience a cohesive, private-label unboxing that builds trust and boosts repeat purchases.
            </p>
            <div class="callout-meta">
              <div class="meta-item">
                <strong>Private-Label Ready</strong>
                <span>Ideal for ecommerce brands, startups & retailers</span>
              </div>
              <div class="meta-item">
                <strong>Sharp Foil Stamping</strong>
                <span>Gold and metallic debossed precision</span>
              </div>
              <div class="meta-item">
                <strong>Dual Category</strong>
                <span>Available across jewelry & watch packaging lines</span>
              </div>
            </div>
          </div>
          
          <div class="callout-action-col">
            <div class="quote-box">
              <span class="quote-text">“Turn every unboxing into a premium brand touchpoint.”</span>
              <a href="#branding" class="btn btn-primary" style="margin-top: 1rem; width: 100%;">
                <span>Learn Custom Embossing</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pillars-section {
    background-color: var(--bg-page);
  }

  .section-intro {
    max-width: 780px;
    margin-bottom: 3.5rem;
  }

  .section-title {
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Asymmetric 2+1 Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 992px) {
    .pillars-grid {
      grid-template-columns: 1.25fr 0.95fr;
    }
  }

  .pillar-card {
    padding: 2.25rem 2rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pillar-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-bottom: 0.75rem;
  }

  .pillar-heading {
    margin-bottom: 1rem;
  }

  .pillar-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .pillar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pillar-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .check-icon {
    color: var(--accent-gold);
    flex-shrink: 0;
  }

  .facility-code {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    padding-top: 1rem;
    display: block;
    border-top: 1px dashed var(--border-medium);
    margin-top: 1.5rem;
  }

  /* Catalogue Pillars */
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-primary);
  }

  /* Full Width Callout (Pillar 3) */
  .pillar-callout {
    grid-column: 1 / -1;
    padding: 2.5rem 2rem;
    background: linear-gradient(135deg, #FFFFFF 0%, #FAF8F4 100%);
    border: 1px solid var(--accent-gold-border);
  }

  @media (min-width: 768px) {
    .pillar-callout {
      padding: 3rem 2.5rem;
    }
  }

  .callout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .callout-grid {
      grid-template-columns: 1.35fr 0.65fr;
      gap: 3rem;
    }
  }

  .callout-heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 0.875rem;
  }

  .callout-body {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .callout-body em {
    font-style: normal;
    font-weight: 700;
    color: var(--text-primary);
  }

  .callout-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .callout-meta {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .meta-item strong {
    display: block;
    font-size: 0.875rem;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .meta-item span {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .quote-box {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-primary);
    display: block;
  }
</style>
