---
import { BUSINESS_INFO } from '../data/products';
---

<section class="pillars-section section-spacing" aria-label="Core Manufacturing Capabilities">
  <div class="container">

    <!-- Section intro -->
    <div class="section-intro animate-in">
      <p class="section-eyebrow">Why Soobee's Box</p>
      <h2>The Case for a Single Packaging Supplier</h2>
      <p class="section-lead">
        Fragmenting your packaging across different merchants means inconsistent quality, mismatched finishes, and logistical overhead. We eliminate that problem from a single industrial facility in Karachi.
      </p>
    </div>

    <!-- Asymmetric 2+1 Grid -->
    <div class="pillars-grid">

      <!-- Card 1 (wide): Factory & Direct Manufacturing -->
      <div class="pillar-card pillar-factory card-lift animate-in stagger-1 from-left">
        <div class="pillar-watermark" aria-hidden="true">01</div>
        <div class="pillar-inner">
          <div class="pillar-meta">
            <span class="pillar-tag">01</span>
            <span class="pillar-tag-text">Direct Manufacturer</span>
          </div>
          <h3 class="pillar-heading">S.I.T.E. Area Factory. No Middlemen.</h3>
          <p class="pillar-desc">
            Soobee's Box manufactures and distributes from Karachi's S.I.T.E. industrial zone. Retailers and ecommerce brands buy at direct factory rates, bypassing any reseller markups. Bulk capacity, consistent velvet quality, and nationwide fulfillment are built in.
          </p>
          <ul class="pillar-list">
            <li>Direct factory wholesale pricing</li>
            <li>Consistent velvet upholstery standards batch to batch</li>
            <li>S.I.T.E. Area pickup and freight dispatch across Pakistan</li>
          </ul>
          <div class="facility-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>S.I.T.E. / KHI Industrial Area</span>
          </div>
        </div>
      </div>

      <!-- Card 2 (narrow): Full Catalogue Range -->
      <div class="pillar-card pillar-catalogue card-lift animate-in stagger-2">
        <div class="pillar-watermark" aria-hidden="true">02</div>
        <div class="pillar-inner">
          <div class="pillar-meta">
            <span class="pillar-tag">02</span>
            <span class="pillar-tag-text">Single Source</span>
          </div>
          <h3 class="pillar-heading">One Invoice. Every Box Type.</h3>
          <p class="pillar-desc">
            Ring foam, multi-bangle bridal cases, gold coin recesses, necklace chains, and watch boxes all from one vendor.
          </p>
          <div class="category-grid">
            <span class="cat-tag">Rings &amp; Bands</span>
            <span class="cat-tag">Studs &amp; Jhumkas</span>
            <span class="cat-tag">Lockets &amp; Sets</span>
            <span class="cat-tag">2/4/6 Bangles</span>
            <span class="cat-tag">Gold Coins</span>
            <span class="cat-tag">Chains</span>
            <span class="cat-tag">Watch Boxes</span>
            <span class="cat-tag">Bridal Sets</span>
          </div>
        </div>
      </div>

      <!-- Full-width dark callout: Logo Embossing -->
      <div class="pillar-callout animate-in stagger-3 scale-in">
        <div class="pillar-watermark callout-watermark" aria-hidden="true">03</div>
        <div class="callout-inner">
          <div class="callout-left">
            <div class="pillar-meta">
              <span class="pillar-tag pillar-tag-inv">03</span>
              <span class="pillar-tag-text pillar-tag-text-inv">In-House Branding</span>
            </div>
            <h3 class="callout-heading">Custom Logo Embossing, Built Into the Same Order</h3>
            <p class="callout-desc">
              Hot-stamp metallic foil die debossing is performed inside the same facility. Your brand logo can appear on every box lid, with zero external subcontractors. Provide your vector artwork and we coordinate the rest.
            </p>
          </div>
          <div class="callout-right" aria-hidden="true">
            <div class="emboss-demo">
              <div class="emboss-surface">
                <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
                  <rect x="8" y="14" width="40" height="28" rx="2" stroke="#E5C37A" stroke-width="1.5" fill="none"/>
                  <line x1="16" y1="24" x2="40" y2="24" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="16" y1="29" x2="34" y2="29" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="16" y1="34" x2="26" y2="34" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span class="emboss-label">YOUR LOGO</span>
              </div>
              <p class="emboss-caption">Foil on Velvet Lid</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .pillars-section {
    background-color: var(--bg-surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-intro {
    margin-bottom: 3.5rem;
    max-width: 640px;
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 0.875rem;
  }

  .section-intro h2 {
    margin-bottom: 1rem;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.68;
    color: var(--text-secondary);
    max-width: 560px;
  }

  /* Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .pillars-grid {
      grid-template-columns: 3fr 2fr;
    }

    .pillar-callout {
      grid-column: 1 / -1;
    }
  }

  /* Cards */
  .pillar-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }

  .pillar-card:hover {
    border-color: var(--accent-gold-border);
  }

  /* Watermark number */
  .pillar-watermark {
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: 7rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.04em;
  }

  [data-theme="dark"] .pillar-watermark {
    opacity: 0.05;
  }

  .pillar-inner {
    padding: 2.25rem 2rem;
    position: relative;
  }

  .pillar-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.125rem;
  }

  .pillar-tag {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    background-color: var(--accent-gold-soft);
    border: 1px solid var(--accent-gold-border);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }

  .pillar-tag-inv {
    color: #E5C37A;
    background-color: rgba(229, 195, 122, 0.1);
    border-color: rgba(229, 195, 122, 0.25);
  }

  .pillar-tag-text {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }

  .pillar-tag-text-inv {
    color: rgba(255, 255, 255, 0.4);
  }

  .pillar-heading {
    margin-bottom: 1rem;
  }

  .pillar-desc {
    font-size: 0.9375rem;
    line-height: 1.68;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .pillar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 1.75rem;
  }

  .pillar-list li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding-left: 1.125rem;
    position: relative;
    line-height: 1.5;
  }

  .pillar-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--accent-gold);
    opacity: 0.7;
  }

  .facility-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 0.3rem 0.75rem;
    letter-spacing: 0.02em;
  }

  /* Category grid */
  .category-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cat-tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 0.25rem 0.65rem;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .cat-tag:hover {
    border-color: var(--accent-gold-border);
    color: var(--accent-gold-text);
    background-color: var(--accent-gold-soft);
  }

  /* Dark callout */
  .pillar-callout {
    background-color: var(--velvet-navy);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .pillar-callout:hover {
    border-color: rgba(229, 195, 122, 0.2);
  }

  [data-theme="dark"] .pillar-callout {
    background-color: #0A0E1A;
    border-color: rgba(229, 195, 122, 0.08);
  }

  .callout-watermark {
    color: #FFFFFF;
    right: 2rem;
    top: -1rem;
    opacity: 0.04;
  }

  .callout-inner {
    padding: 2.5rem 2.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    position: relative;
  }

  @media (min-width: 640px) {
    .callout-inner {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
  }

  .callout-heading {
    color: #F5F3EF;
    margin-bottom: 1rem;
  }

  .callout-desc {
    font-size: 0.9375rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Emboss demo */
  .emboss-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .emboss-surface {
    background-color: #0F0E0D;
    border: 1px solid rgba(229, 195, 122, 0.15);
    border-radius: 10px;
    width: 128px;
    height: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
  }

  .emboss-label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #E5C37A;
    font-family: var(--font-display);
  }

  .emboss-caption {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
  }
</style>
