---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';
---

<section class="contact-section section-spacing" id="contact" aria-label="Wholesale Inquiries and Contact Directory">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Direct Official Contact Directory -->
      <div class="contact-directory animate-in">
        <span class="badge badge-gold">Direct Communications</span>
        <h2 class="contact-title">Wholesale Inquiries & Sales Officers</h2>
        <p class="contact-intro">
          Contact our team directly via phone or WhatsApp. For bulk wholesale orders, custom embossing quotations, and sample verifications, reach out to our dedicated officers.
        </p>

        <div class="directory-cards">
          <!-- Head Office -->
          <div class="dir-card head-office-card surface-card">
            <div class="dir-meta">
              <span class="dir-role">Head Office / General Inquiries</span>
              <strong class="dir-name">Karachi Central Office</strong>
            </div>
            <a 
              href={createWhatsAppUrl(BUSINESS_INFO.contacts.headOffice, "Assalam-o-Alaikum, I am reaching out to Soobee's Box Head Office regarding business packaging.")} 
              class="dir-phone-link"
              target="_blank" 
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="wa-icon">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>{BUSINESS_INFO.contacts.headOffice}</span>
            </a>
          </div>

          <!-- Sales Officers List -->
          <div class="sales-officers-container">
            <span class="officers-title">Sales & Wholesale Officers</span>
            <div class="officers-list">
              {BUSINESS_INFO.contacts.salesOfficers.map((officer) => (
                <div class="officer-row surface-card">
                  <div>
                    <span class="officer-name">{officer.name}</span>
                    <span class="officer-desc">Wholesale, catalogue & custom quote orders</span>
                  </div>
                  <a 
                    href={createWhatsAppUrl(officer.phone, `Assalam-o-Alaikum, I am inquiring about wholesale packaging orders with ${officer.name}.`)} 
                    class="btn btn-secondary officer-btn"
                    target="_blank" 
                    rel="noopener noreferrer"
                    aria-label={`WhatsApp ${officer.name} at ${officer.phone}`}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                    <span>{officer.phone}</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="linktree-reference">
          <span>Digital Hub:</span>
          <a href={BUSINESS_INFO.linktree} target="_blank" rel="noopener noreferrer" class="linktree-link">
            linktr.ee/soobeesbox
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Quotation Generator -->
      <div class="contact-rfq animate-in stagger-2">
        <div class="rfq-card surface-card">
          <div class="rfq-header">
            <span class="rfq-tag">Fast WhatsApp Quotation</span>
            <h3 class="rfq-title">Generate a Pre-Structured RFQ</h3>
            <p class="rfq-caption">Configure your packaging requirements below to send an organized inquiry directly to our sales team on WhatsApp.</p>
          </div>

          <form id="rfqForm" class="rfq-form" onsubmit="return false;">
            <div class="form-group">
              <label for="rfqCategory" class="form-label">Packaging Category:</label>
              <select id="rfqCategory" class="form-select">
                <option value="Velvet Jewelry Boxes (General)">Velvet Jewelry Boxes (General)</option>
                <option value="Ring & Tops Boxes (0221, 0222, 0340)">Ring & Tops Boxes (0221, 0222, 0340)</option>
                <option value="Locket & Earring Sets (0404, 0403, 0278)">Locket & Earring Sets (0404, 0403, 0278)</option>
                <option value="Bangle Boxes (2, 4, 6 Chori)">Bangle Boxes (2, 4, 6 Chori)</option>
                <option value="Gold Coin / Ginni Boxes (0331, 0394, 0301, 0304)">Gold Coin / Ginni Boxes</option>
                <option value="Watch Boxes (Full Range)">Watch Boxes (Full Range)</option>
                <option value="Multiple Categories / Mixed Order">Multiple Categories / Mixed Order</option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="rfqQuantity" class="form-label">Estimated Quantity (Units):</label>
                <input 
                  type="text" 
                  id="rfqQuantity" 
                  placeholder="e.g. 500, 1000, 5000" 
                  class="form-input" 
                  required
                />
              </div>

              <div class="form-group">
                <label for="rfqCity" class="form-label">Destination City:</label>
                <select id="rfqCity" class="form-select">
                  <option value="Karachi (Local Pickup/Delivery)">Karachi (Local Pickup/Delivery)</option>
                  <option value="Lahore">Lahore</option>
                  <option value="Islamabad / Rawalpindi">Islamabad / Rawalpindi</option>
                  <option value="Peshawar">Peshawar</option>
                  <option value="Faisalabad">Faisalabad</option>
                  <option value="Multan">Multan</option>
                  <option value="Quetta">Quetta</option>
                  <option value="Other City in Pakistan">Other City in Pakistan</option>
                </select>
              </div>
            </div>

            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" id="rfqBranding" class="checkbox-input" />
                <span>Require custom metallic logo embossing (hot-stamping)?</span>
              </label>
            </div>

            <div class="form-group">
              <label for="rfqNotes" class="form-label">Specific SKUs or Additional Notes (Optional):</label>
              <textarea 
                id="rfqNotes" 
                rows="3" 
                placeholder="Mention specific product codes like 0221, 0436, or custom velvet color preferences..." 
                class="form-textarea"
              ></textarea>
            </div>

            <button type="button" id="submitRfqBtn" class="btn btn-primary rfq-submit-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Send Pre-Filled Quote Request on WhatsApp</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--bg-page);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
    }
  }

  .contact-title {
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .contact-intro {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }

  .directory-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .head-office-card {
    padding: 1.5rem;
    border-color: var(--accent-gold-border);
    background: linear-gradient(135deg, #FFFFFF 0%, #FAF8F4 100%);
  }

  .dir-role {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-gold-hover);
    margin-bottom: 0.25rem;
  }

  .dir-name {
    display: block;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: 0.875rem;
  }

  .dir-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .dir-phone-link:hover {
    color: var(--accent-gold);
  }

  .wa-icon {
    color: var(--accent-gold);
  }

  .sales-officers-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .officers-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .officers-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .officer-row {
    padding: 1.125rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background-color: #FFFFFF;
  }

  .officer-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .officer-desc {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .officer-btn {
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .linktree-reference {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .linktree-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
    color: var(--accent-gold-hover);
  }

  .linktree-link:hover {
    text-decoration: underline;
  }

  /* RFQ Form Card */
  .rfq-card {
    padding: 2.25rem 2rem;
    background-color: #FFFFFF;
    border-radius: 12px;
  }

  .rfq-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 0.25rem;
  }

  .rfq-title {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .rfq-caption {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.75rem;
  }

  .rfq-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.65rem 0.875rem;
    border: 1px solid var(--border-medium);
    border-radius: 6px;
    background-color: var(--bg-page);
    font-size: 0.875rem;
    color: var(--text-primary);
    outline: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--accent-gold);
    background-color: #FFFFFF;
  }

  .checkbox-group {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--text-primary);
    cursor: pointer;
  }

  .checkbox-input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent-gold);
    cursor: pointer;
  }

  .rfq-submit-btn {
    width: 100%;
    padding: 0.875rem 1.5rem;
    font-size: 0.9375rem;
    margin-top: 0.5rem;
  }
</style>

<script>
  const submitBtn = document.getElementById('submitRfqBtn');

  if (submitBtn) {
    submitBtn.addEventListener('click', () => {
      const category = (document.getElementById('rfqCategory') as HTMLSelectElement)?.value || 'Jewelry Boxes';
      const quantity = (document.getElementById('rfqQuantity') as HTMLInputElement)?.value.trim() || 'Not specified';
      const city = (document.getElementById('rfqCity') as HTMLSelectElement)?.value || 'Karachi';
      const branding = (document.getElementById('rfqBranding') as HTMLInputElement)?.checked ? 'Yes (Custom Logo Embossing Required)' : 'No (Standard Boxes)';
      const notes = (document.getElementById('rfqNotes') as HTMLTextAreaElement)?.value.trim() || 'None';

      const message = `Assalam-o-Alaikum Soobee's Box Team,
I would like to request a wholesale quotation:

• Category: ${category}
• Estimated Quantity: ${quantity} units
• Custom Logo Embossing: ${branding}
• Delivery / Pickup City: ${city}
• Specific SKUs / Notes: ${notes}

Please provide current pricing and availability. Thank you.`;

      // Format WhatsApp URL to Sales Officer 1 (0333-1145552)
      const phone = '923331145552';
      const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
    });
  }
</script>
