---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';
---

<footer class="site-footer" aria-label="Site Footer">
  <div class="container footer-top">
    <!-- Col 1: Brand & Positioning -->
    <div class="footer-brand-col">
      <a href="#" class="footer-logo-link" aria-label="Soobee's Box Home">
        <img 
          src="/images/logo.png" 
          alt="Soobee's Box" 
          width="200" 
          height="52" 
          class="footer-logo-img"
          loading="lazy"
        />
      </a>
      <p class="footer-tagline">
        {BUSINESS_INFO.positioning}
      </p>
      <p class="footer-motto">
        <em>"{BUSINESS_INFO.tagline}"</em> • <span>{BUSINESS_INFO.localTagline}</span>
      </p>

      <div class="footer-digital">
        <a href={BUSINESS_INFO.linktree} target="_blank" rel="noopener noreferrer" class="linktree-badge">
          <span>Digital Linktree Profile</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Col 2: Navigation Links -->
    <div class="footer-nav-col">
      <h4 class="footer-heading">Quick Navigation</h4>
      <ul class="footer-links">
        <li><a href="#catalogue">Documented Catalogue</a></li>
        <li><a href="#branding">Custom Logo Embossing</a></li>
        <li><a href="#watches">Watch Box Supply</a></li>
        <li><a href="#locations">Karachi S.I.T.E. Factory</a></li>
        <li><a href="#locations">Hyderi Gold Mark Mall Outlet</a></li>
        <li><a href="#contact">Wholesale Contact & RFQ</a></li>
      </ul>
    </div>

    <!-- Col 3: Documented SKUs Quick Index -->
    <div class="footer-index-col">
      <h4 class="footer-heading">Documented Box Codes</h4>
      <div class="sku-tags-grid">
        <span class="f-sku" title="2*2 Ring Foam">0221 (Ring)</span>
        <span class="f-sku" title="2*2 Challa">0222 (Challa)</span>
        <span class="f-sku" title="2*2 Tops">0340 (Tops)</span>
        <span class="f-sku" title="2*2 Ginni">0331 (Coin)</span>
        <span class="f-sku" title="Chain Leher">0237 (Chain)</span>
        <span class="f-sku" title="2 Chori">0446 (2 Bangle)</span>
        <span class="f-sku" title="4 Chori">0274 (4 Bangle)</span>
        <span class="f-sku" title="6 Chori">0436 (6 Bangle)</span>
        <span class="f-sku" title="3.5*2.5 Cufling">0288 (Cufflink)</span>
        <span class="f-sku" title="3.5*2.5 Jhumki">0398 (Jhumki)</span>
      </div>
      <span class="f-color-note">Standard Colors: Black, Maroon, Red, Blue, Purple</span>
    </div>

    <!-- Col 4: Verified Karachi Physical Locations -->
    <div class="footer-locations-col">
      <h4 class="footer-heading">Karachi Facilities</h4>
      <div class="f-loc-item">
        <strong>Manufacturing / Dispatch Plant:</strong>
        <p>{BUSINESS_INFO.factoryLocation.area}</p>
      </div>
      <div class="f-loc-item" style="margin-top: 0.75rem;">
        <strong>Retail Outlet & Showroom:</strong>
        <p>{BUSINESS_INFO.retailOutlet.address}</p>
      </div>
      <div class="f-contact-quick" style="margin-top: 1rem;">
        <span>Head Office: <strong>{BUSINESS_INFO.contacts.headOffice}</strong></span>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">
        © {new Date().getFullYear()} Soobee's Box. All rights reserved. Pakistan's complete jewelry & watch packaging manufacturer.
      </p>
      <div class="footer-disclaimer">
        <span>B2B Packaging Supplier & Manufacturer • Karachi, Pakistan</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #FFFFFF;
    border-top: 1px solid var(--border-subtle);
    padding-top: 4.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 1.3fr 0.9fr 1.1fr 1.3fr;
      gap: 2.5rem;
    }
  }

  .footer-logo-link {
    display: inline-block;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .footer-tagline {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .footer-motto {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  .footer-motto em {
    color: var(--text-secondary);
  }

  .linktree-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-gold-hover);
    background-color: var(--accent-gold-soft);
    padding: 0.35rem 0.65rem;
    border-radius: 4px;
    border: 1px solid var(--accent-gold-border);
  }

  .linktree-badge:hover {
    text-decoration: underline;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--accent-gold);
  }

  .sku-tags-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .f-sku {
    font-size: 0.6875rem;
    font-weight: 600;
    background-color: var(--bg-surface-subtle);
    padding: 0.2rem 0.45rem;
    border-radius: 3px;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .f-color-note {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .f-loc-item strong {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  .f-loc-item p {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .f-contact-quick {
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .f-contact-quick strong {
    color: var(--accent-gold);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding: 1.5rem 0;
    background-color: var(--bg-page);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
