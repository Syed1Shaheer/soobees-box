---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const whatsappUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.headOffice,
  "Assalam-o-Alaikum, I am inquiring about wholesale jewelry and watch packaging from Soobee's Box."
);
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="#" class="brand-logo" aria-label="Soobee's Box Home">
      <img 
        src="/images/logo.png" 
        alt="Soobee's Box - Pakistan's Complete Jewelry & Watch Packaging Manufacturer" 
        width="240" 
        height="60" 
        class="logo-img"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="#catalogue" class="nav-link">Product Catalogue</a>
      <a href="#branding" class="nav-link">Custom Logo Embossing</a>
      <a href="#watches" class="nav-link">Watch Packaging</a>
      <a href="#locations" class="nav-link">Factory & Outlet</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-primary btn-whatsapp"
        aria-label="Contact on WhatsApp: 0333-1145554"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>Wholesale: 0333-1145554</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        type="button" 
        class="mobile-menu-btn" 
        aria-expanded="false" 
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
        id="mobileMenuToggle"
      >
        <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileMenu">
    <div class="mobile-nav-links">
      <a href="#catalogue" class="mobile-link">Product Catalogue</a>
      <a href="#branding" class="mobile-link">Custom Logo Embossing</a>
      <a href="#watches" class="mobile-link">Watch Packaging</a>
      <a href="#locations" class="mobile-link">Factory & Outlet</a>
      <a href="#contact" class="mobile-link">Contact & Direct Numbers</a>
      <div class="mobile-cta-wrapper">
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary"
          style="width: 100%;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .site-header.header-scrolled {
    box-shadow: 0 4px 20px rgba(18, 20, 23, 0.06);
    background-color: rgba(255, 255, 255, 0.98);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .logo-img {
    height: 46px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  @media (min-width: 992px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    position: relative;
    padding: 0.5rem 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-gold);
    transition: width var(--duration-normal) var(--ease-out);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-whatsapp {
    display: none;
  }

  @media (min-width: 640px) {
    .btn-whatsapp {
      display: inline-flex;
    }
  }

  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--border-medium);
    border-radius: 4px;
    color: var(--text-primary);
    cursor: pointer;
  }

  @media (min-width: 992px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-drawer {
    display: none;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    padding: 1.25rem 1.5rem 2rem;
    box-shadow: var(--shadow-md);
  }

  .mobile-drawer.is-open {
    display: block;
    animation: fadeIn 0.2s var(--ease-out);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    height: 44px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-link:hover {
    color: var(--accent-gold);
  }

  .mobile-cta-wrapper {
    margin-top: 1.25rem;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const iconOpen = toggleBtn?.querySelector('.icon-open') as HTMLElement;
  const iconClose = toggleBtn?.querySelector('.icon-close') as HTMLElement;

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      if (iconOpen && iconClose) {
        iconOpen.style.display = isOpen ? 'none' : 'block';
        iconClose.style.display = isOpen ? 'block' : 'none';
      }
    });

    // Close on navigation link click
    const mobileLinks = mobileMenu.querySelectorAll('.mobile-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (iconOpen && iconClose) {
          iconOpen.style.display = 'block';
          iconClose.style.display = 'none';
        }
      });
    });
  }
</script>
