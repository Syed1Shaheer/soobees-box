---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const whatsappUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.headOffice,
  "Assalam-o-Alaikum, I am inquiring about wholesale jewelry and watch packaging from Soobee's Box."
);
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="#" class="brand-logo" aria-label="Soobee's Box Home">
      <img
        src="/images/logo.png"
        alt="Soobee's Box"
        width="200"
        height="52"
        class="logo-img"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="#catalogue" class="nav-link">Catalogue</a>
      <a href="#branding" class="nav-link">Logo Embossing</a>
      <a href="#watches" class="nav-link">Watch Packaging</a>
      <a href="#locations" class="nav-link">Factory & Outlet</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Theme Toggle -->
      <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label="Toggle light and dark mode"
        title="Toggle theme"
      >
        <!-- Sun icon (visible in dark mode) -->
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- WhatsApp CTA -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-whatsapp"
        aria-label="Contact on WhatsApp: 0333-1145554"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>0333-1145554</span>
      </a>

      <!-- Mobile Hamburger -->
      <button
        type="button"
        class="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobileMenu"
        aria-label="Toggle navigation menu"
        id="mobileMenuToggle"
      >
        <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="8" x2="21" y2="8"></line>
          <line x1="3" y1="16" x2="21" y2="16"></line>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileMenu" aria-hidden="true">
    <nav class="mobile-nav-links" aria-label="Mobile Navigation">
      <a href="#catalogue" class="mobile-link">Product Catalogue</a>
      <a href="#branding" class="mobile-link">Custom Logo Embossing</a>
      <a href="#watches" class="mobile-link">Watch Packaging</a>
      <a href="#locations" class="mobile-link">Factory & Outlet</a>
      <a href="#contact" class="mobile-link">Contact</a>
    </nav>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary mobile-wa-btn"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <span>WhatsApp Wholesale Inquiry</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border-subtle);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .site-header.header-scrolled {
    background-color: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 16px rgba(24, 23, 22, 0.07);
    border-bottom-color: var(--border-medium);
  }

  [data-theme="dark"] .site-header.header-scrolled {
    background-color: rgba(13, 12, 11, 0.9);
    box-shadow: 0 1px 16px rgba(0, 0, 0, 0.4);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 40px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }

  /* ScaleX underline nav links */
  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    position: relative;
    padding: 0.25rem 0;
    transition: color var(--duration-normal) var(--ease-out);
    min-height: unset;
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--accent-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* Round Theme Toggle */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-height: 38px;
    background: transparent;
    border: 1.5px solid var(--border-subtle);
    border-radius: 50%;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    background-color: var(--accent-gold-soft);
  }

  /* Show sun in dark mode, moon in light mode */
  .icon-sun { display: none; }
  .icon-moon { display: block; }

  [data-theme="dark"] .icon-sun { display: block; }
  [data-theme="dark"] .icon-moon { display: none; }

  .btn-whatsapp {
    display: none;
    box-shadow: 0 0 0 2px var(--accent-gold-border);
  }

  @media (min-width: 640px) {
    .btn-whatsapp {
      display: inline-flex;
    }
  }

  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-height: 38px;
    background: transparent;
    border: 1.5px solid var(--border-subtle);
    border-radius: 8px;
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .mobile-menu-btn:hover {
    background-color: var(--bg-surface-subtle);
    border-color: var(--border-medium);
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    padding: 1rem 1.5rem 1.5rem;
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    height: 48px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-subtle);
    transition: color var(--duration-fast) var(--ease-out),
                padding-left var(--duration-fast) var(--ease-out);
  }

  .mobile-link:last-child {
    border-bottom: none;
  }

  .mobile-link:hover {
    color: var(--text-primary);
    padding-left: 0.5rem;
  }

  .mobile-wa-btn {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>

<script>
  // Theme Toggle
  const themeToggle = document.getElementById('themeToggle');

  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('soobees_theme', newTheme);
  });

  // Mobile Menu
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const iconOpen = toggleBtn?.querySelector('.icon-open') as HTMLElement | null;
  const iconClose = toggleBtn?.querySelector('.icon-close') as HTMLElement | null;

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileMenu.setAttribute('aria-hidden', String(!isOpen));
      if (iconOpen && iconClose) {
        iconOpen.style.display = isOpen ? 'none' : 'block';
        iconClose.style.display = isOpen ? 'block' : 'none';
      }
    });

    mobileMenu.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
        if (iconOpen && iconClose) {
          iconOpen.style.display = 'block';
          iconClose.style.display = 'none';
        }
      });
    });
  }
</script>
