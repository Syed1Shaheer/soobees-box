---
import { BUSINESS_INFO, createWhatsAppUrl, DOCUMENTED_COLORS } from '../data/products';

const wholesaleUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.headOffice,
  "Assalam-o-Alaikum, I would like to inquire about wholesale jewelry/watch packaging pricing and MOQ from Soobee's Box."
);

const colors = [
  { name: 'Midnight Black', hex: '#1A1A1E' },
  { name: 'Deep Maroon', hex: '#581622' },
  { name: 'Crimson Red', hex: '#871923' },
  { name: 'Royal Blue', hex: '#1C3352' },
  { name: 'Regal Purple', hex: '#432247' },
];
---

<section class="hero-section" aria-label="Introduction to Soobee's Box">
  <div class="container hero-grid">
    <!-- Left Column: Core B2B Value Hook -->
    <div class="hero-content animate-in">
      <p class="hero-eyebrow">Karachi S.I.T.E. Area — Direct Manufacturer</p>

      <h1 class="hero-title">
        Jewelry &amp; Watch<br>Packaging.<br>
        <em>Factory Direct.</em>
      </h1>

      <p class="hero-lead">
        One supplier. Every box category. We manufacture the full range of premium velvet jewelry boxes and watch packaging from our S.I.T.E. industrial facility, with in-house custom logo embossing.
      </p>

      <div class="hero-actions">
        <a
          href={wholesaleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Request Wholesale Quote</span>
        </a>
        <a href="#catalogue" class="btn btn-secondary">
          <span>Browse 28 SKUs</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Fact strip -->
      <div class="hero-facts">
        <div class="fact">
          <span class="fact-label">Location</span>
          <span class="fact-value">S.I.T.E. Area, Karachi</span>
        </div>
        <div class="fact-divider" aria-hidden="true"></div>
        <div class="fact">
          <span class="fact-label">Categories</span>
          <span class="fact-value">Jewelry + Watch Boxes</span>
        </div>
        <div class="fact-divider" aria-hidden="true"></div>
        <div class="fact">
          <span class="fact-label">Branding</span>
          <span class="fact-value">In-house Logo Embossing</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Velvet Showcase Panel -->
    <div class="hero-showcase animate-in stagger-2 from-right" aria-label="Velvet colors and foil finish showcase">
      <div class="showcase-panel">

        <!-- Dark velvet surface with shimmer foil -->
        <div class="showcase-velvet">
          <div class="foil-emboss-demo" aria-label="Gold foil embossing preview">
            <div class="foil-ring"></div>
            <svg width="52" height="52" viewBox="0 0 52 52" fill="none" aria-hidden="true">
              <rect x="6" y="12" width="40" height="28" rx="2" stroke="#E5C37A" stroke-width="1.25" fill="none"/>
              <line x1="14" y1="21" x2="38" y2="21" stroke="#E5C37A" stroke-width="1.25" stroke-linecap="round"/>
              <line x1="14" y1="26" x2="30" y2="26" stroke="#E5C37A" stroke-width="1.25" stroke-linecap="round"/>
              <line x1="14" y1="31" x2="22" y2="31" stroke="#E5C37A" stroke-width="1.25" stroke-linecap="round"/>
              <circle cx="38" cy="32" r="5" stroke="#E5C37A" stroke-width="1.25" fill="none"/>
              <path d="M36 32l1.5 1.5L40.5 30" stroke="#E5C37A" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="foil-brand-text">YOUR BRAND</span>
          </div>
          <div class="showcase-velvet-label">Metallic hot-stamp foil embossing</div>
        </div>

        <!-- Color swatches as wide pills -->
        <div class="showcase-swatches">
          <p class="swatches-heading">Standard Velvet Upholstery — 5 Colors</p>
          <div class="swatch-pills">
            {colors.map((color) => (
              <div class="swatch-pill">
                <span class="swatch-pill-color" style={`background-color: ${color.hex}`} aria-hidden="true"></span>
                <span class="swatch-pill-name">{color.name}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="showcase-footer">
          <span class="showcase-footer-text">Custom colors &amp; logo embossing available on inquiry</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border-subtle);
    padding-top: 5rem;
    padding-bottom: 5rem;
    min-height: 85vh;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
    width: 100%;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 55% 1fr;
      gap: 5rem;
    }
  }

  .hero-content {
    max-width: 640px;
  }

  /* Eyebrow */
  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 1.25rem;
  }

  /* Large editorial heading */
  .hero-title {
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    line-height: 1.02;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent-gold);
    font-weight: 600;
  }

  .hero-lead {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 3rem;
  }

  /* Fact strip */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fact-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .fact-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-body);
  }

  .fact-divider {
    width: 1px;
    height: 32px;
    background-color: var(--border-subtle);
    flex-shrink: 0;
  }

  /* ─── Showcase Panel ─── */
  .hero-showcase {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .hero-showcase {
      max-width: 100%;
      margin: 0;
    }
  }

  .showcase-panel {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-medium);
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-surface);
  }

  /* Dark velvet area */
  .showcase-velvet {
    background-color: #0F0E0D;
    padding: 2.5rem 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    position: relative;
    min-height: 200px;
    justify-content: center;
  }

  /* Foil emboss demo */
  .foil-emboss-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  /* Glowing ring behind the logo */
  .foil-ring {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 1px solid rgba(229, 195, 122, 0.2);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: gold-pulse 3s ease-in-out infinite;
  }

  .foil-brand-text {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #E5C37A;
    /* Shimmer animation */
    background: linear-gradient(
      90deg,
      #C9A254 0%,
      #E5C37A 30%,
      #F5DFA0 50%,
      #E5C37A 70%,
      #C9A254 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 3s linear infinite;
  }

  .showcase-velvet-label {
    font-size: 0.6875rem;
    color: rgba(229, 195, 122, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-body);
  }

  /* Swatches section */
  .showcase-swatches {
    padding: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .swatches-heading {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .swatch-pills {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .swatch-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .swatch-pill-color {
    width: 40px;
    height: 14px;
    border-radius: 100px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
    display: block;
  }

  [data-theme="dark"] .swatch-pill-color {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .swatch-pill-name {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Footer */
  .showcase-footer {
    padding: 0.875rem 1.75rem;
    background-color: var(--bg-surface-subtle);
  }

  .showcase-footer-text {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
