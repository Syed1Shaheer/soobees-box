---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const factoryVisitUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.headOffice,
  "Assalam-o-Alaikum, I would like to schedule a factory visit or pickup at the S.I.T.E. Area facility in Karachi."
);

const outletVisitUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.salesOfficers[0].phone,
  "Assalam-o-Alaikum, I am planning to visit the Hyderi Gold Mark Mall outlet for packaging samples."
);
---

<section class="locations-section section-spacing" id="locations" aria-label="Karachi Manufacturing Facility and Retail Outlet">
  <div class="container">
    <div class="section-intro animate-in">
      <p class="section-eyebrow">Karachi Footprint</p>
      <h2>Factory & Retail Outlet Locations</h2>
      <p class="section-lead">
        We serve businesses across Pakistan from two strategic points in Karachi: our manufacturing and dispatch plant in S.I.T.E. Area, and our dedicated retail showroom in North Nazimabad.
      </p>
    </div>

    <div class="locations-grid">
      <!-- Location 1: S.I.T.E. Area Factory -->
      <div class="location-card animate-in stagger-1">
        <div class="loc-header">
          <span class="loc-type">Manufacturing & Bulk Supply</span>
          <div class="loc-dot active" title="Primary facility"></div>
        </div>
        <h3 class="loc-title">{BUSINESS_INFO.factoryLocation.title}</h3>
        <p class="loc-area">{BUSINESS_INFO.factoryLocation.area}</p>

        <p class="loc-desc">
          The operational core of Soobee's Box. Handles bulk production runs, hot-stamp die tooling, raw velvet processing, quality inspection, and nationwide freight dispatches.
        </p>

        <div class="loc-services">
          <span class="service-tag">Bulk Order Pickup</span>
          <span class="service-tag">Custom Logo Tooling</span>
          <span class="service-tag">Factory Direct Pricing</span>
          <span class="service-tag">Nationwide Logistics</span>
        </div>

        <div class="loc-footer">
          <a 
            href={factoryVisitUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-primary loc-btn"
          >
            <span>Coordinate Factory Dispatch</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Location 2: Hyderi Gold Mark Mall Outlet -->
      <div class="location-card animate-in stagger-2">
        <div class="loc-header">
          <span class="loc-type">Retail & Sample Counter</span>
          <div class="loc-dot" title="Retail outlet"></div>
        </div>
        <h3 class="loc-title">{BUSINESS_INFO.retailOutlet.title}</h3>
        <p class="loc-area">Hyderi Gold Mark Mall, Shop #34–37<br>North Nazimabad, Karachi 74700</p>

        <p class="loc-desc">
          Walk in to inspect sample stock across all documented box categories and colors. Immediate purchases available from counter. Best for retailers wanting to verify quality before placing bulk orders.
        </p>

        <div class="loc-services">
          <span class="service-tag">Sample Inspection</span>
          <span class="service-tag">Immediate Counter Stock</span>
          <span class="service-tag">Retailer Consultation</span>
          <span class="service-tag">Walk-in Welcome</span>
        </div>

        <div class="loc-footer">
          <a 
            href={outletVisitUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-secondary loc-btn"
          >
            <span>Plan Your Visit</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .locations-section {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-intro {
    max-width: 600px;
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 0.875rem;
  }

  .section-intro h2 {
    margin-bottom: 0.875rem;
  }

  .section-lead {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .locations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .location-card {
    background-color: var(--bg-surface);
    border: 1.5px solid var(--border-subtle);
    border-radius: 14px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition:
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
    will-change: transform;
  }

  .location-card:hover {
    transform: scale(1.015) translateY(-5px);
    border-color: var(--accent-gold-border);
    box-shadow: var(--shadow-card-hover);
  }

  .loc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .loc-type {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent-gold-text);
    background-color: var(--accent-gold-soft);
    border: 1px solid var(--accent-gold-border);
    border-radius: 100px;
    padding: 0.3rem 0.75rem;
  }

  .loc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--border-medium);
    flex-shrink: 0;
  }

  .loc-dot.active {
    background-color: var(--accent-gold);
  }

  .loc-title {
    font-size: 1.125rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .loc-area {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .loc-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .loc-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .service-tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 0.25rem 0.65rem;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .service-tag:hover {
    border-color: var(--accent-gold-border);
    color: var(--accent-gold-text);
    background-color: var(--accent-gold-soft);
  }

  .loc-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .loc-btn {
    display: inline-flex;
  }
</style>
