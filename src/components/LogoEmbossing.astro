---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const logoInquiryUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.headOffice,
  "Assalam-o-Alaikum, I am interested in custom logo embossing on velvet packaging from Soobee's Box for my brand."
);
---

<section class="branding-section section-spacing" id="branding" aria-label="Custom Logo Embossing Services">
  <div class="container">
    <div class="branding-grid">

      <!-- Left Column: Timeline Process -->
      <div class="branding-content animate-in from-left">
        <p class="section-eyebrow">The Primary Differentiator</p>
        <h2 class="branding-title">Your Logo.<br><em>Our Craftsmanship.</em></h2>
        <p class="branding-lead">
          Don't ship your jewelry or watches in generic, unbranded boxes. We precision stamp your logo onto the velvet lid through in-house hot-foil die debossing, turning every unboxing into a branded moment.
        </p>

        <!-- Timeline steps -->
        <div class="timeline">
          <div class="timeline-track" aria-hidden="true"></div>

          <div class="timeline-step">
            <div class="timeline-node" aria-hidden="true">
              <span class="timeline-num">01</span>
            </div>
            <div class="timeline-content">
              <strong>Vector Artwork Provision</strong>
              <p>Provide your brand logo in vector format (AI, EPS, or high-res SVG). Our tooling team prepares the hot-stamp die at no extra step for you.</p>
            </div>
          </div>

          <div class="timeline-step">
            <div class="timeline-node" aria-hidden="true">
              <span class="timeline-num">02</span>
            </div>
            <div class="timeline-content">
              <strong>Precision Hot-Foil Debossing</strong>
              <p>We heat-press the metallic foil directly into the velvet lid, creating a tactile, raised impression with razor-sharp edge definition. Foil finishes available in gold, silver, and matte.</p>
            </div>
          </div>

          <div class="timeline-step">
            <div class="timeline-node" aria-hidden="true">
              <span class="timeline-num">03</span>
            </div>
            <div class="timeline-content">
              <strong>Bulk Delivery, Factory Direct</strong>
              <p>Branded boxes ship directly from our Karachi S.I.T.E. facility to your storefront, warehouse, or fulfillment center. No third party involved.</p>
            </div>
          </div>
        </div>

        <a
          href={logoInquiryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary branding-cta"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Inquire About Custom Stamping</span>
        </a>
      </div>

      <!-- Right Column: Visual Preview -->
      <div class="branding-visual animate-in stagger-2 from-right" aria-label="Logo embossing process preview">
        <div class="preview-stack">

          <!-- Velvet lid mockup with shimmer -->
          <div class="velvet-preview">
            <div class="velvet-lid">
              <div class="foil-stamp-area">
                <div class="foil-shimmer-ring" aria-hidden="true"></div>
                <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                  <rect x="8" y="16" width="48" height="32" rx="2" stroke="#E5C37A" stroke-width="1.5" fill="none"/>
                  <line x1="18" y1="26" x2="46" y2="26" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="18" y1="32" x2="38" y2="32" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="18" y1="38" x2="30" y2="38" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round"/>
                  <circle cx="46" cy="38" r="6" stroke="#E5C37A" stroke-width="1.5" fill="none"/>
                  <path d="M43.5 38L45 39.5L48.5 36" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="foil-wordmark">YOUR BRAND</span>
              </div>
              <span class="velvet-corner-label">Velvet Lid</span>
            </div>
            <p class="preview-caption">Gold foil hot-stamp debossing on velvet</p>
          </div>

          <!-- Info cards row -->
          <div class="preview-info-row">
            <div class="info-card">
              <span class="info-label">Foil Options</span>
              <div class="foil-swatches">
                <span class="foil-dot" style="background: linear-gradient(135deg, #C9A254, #E5C37A)" title="Gold"></span>
                <span class="foil-dot" style="background: linear-gradient(135deg, #B0B0B0, #D9D9D9)" title="Silver"></span>
                <span class="foil-dot" style="background: linear-gradient(135deg, #2A2A2A, #4A4A4A)" title="Matte Black"></span>
              </div>
            </div>
            <div class="info-card">
              <span class="info-label">Artwork Format</span>
              <span class="info-value">Vector preferred (AI, EPS, SVG)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .branding-section {
    background-color: var(--bg-surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .branding-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .branding-grid {
      grid-template-columns: 55% 1fr;
      gap: 5rem;
    }
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 0.875rem;
  }

  .branding-title {
    margin-bottom: 1.125rem;
  }

  .branding-title em {
    font-style: italic;
    color: var(--accent-gold);
    font-weight: 600;
  }

  .branding-lead {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
    max-width: 520px;
  }

  /* ─── Timeline Steps ─── */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 2.5rem;
    padding-left: 1rem;
  }

  /* Vertical gold line */
  .timeline-track {
    position: absolute;
    left: calc(1rem + 19px);
    top: 20px;
    bottom: 20px;
    width: 1.5px;
    background: linear-gradient(to bottom, var(--accent-gold) 0%, var(--accent-gold-border) 100%);
    opacity: 0.35;
  }

  .timeline-step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    position: relative;
  }

  /* Circular step node */
  .timeline-node {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--bg-surface);
    border: 1.5px solid var(--accent-gold-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .timeline-step:hover .timeline-node {
    background-color: var(--accent-gold-soft);
    border-color: var(--accent-gold);
  }

  .timeline-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.02em;
  }

  .timeline-content {
    padding-top: 0.5rem;
    flex: 1;
  }

  .timeline-content strong {
    display: block;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .timeline-content p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .branding-cta {
    display: inline-flex;
  }

  /* ─── Visual Preview ─── */
  .branding-visual {
    position: relative;
  }

  .preview-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .velvet-preview {
    background-color: var(--bg-surface);
    border: 1.5px solid var(--border-subtle);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .velvet-lid {
    background-color: #0F0E0D;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 180px;
    padding: 2.25rem;
    position: relative;
  }

  .foil-stamp-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  /* Pulsing halo behind foil */
  .foil-shimmer-ring {
    position: absolute;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 1px solid rgba(229, 195, 122, 0.18);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: gold-pulse 3s ease-in-out infinite;
    pointer-events: none;
  }

  .foil-wordmark {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Shimmer sweep */
    background: linear-gradient(
      90deg,
      #C9A254 0%,
      #E5C37A 30%,
      #F5DFA0 50%,
      #E5C37A 70%,
      #C9A254 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 3s linear infinite;
  }

  .velvet-corner-label {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(229, 195, 122, 0.35);
    font-family: var(--font-body);
  }

  .preview-caption {
    padding: 0.75rem 1.125rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface-subtle);
  }

  .preview-info-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }

  .info-card {
    background-color: var(--bg-surface);
    border: 1.5px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .info-card:hover {
    border-color: var(--accent-gold-border);
  }

  .info-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .info-value {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-weight: 500;
    line-height: 1.4;
  }

  .foil-swatches {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .foil-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    display: block;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .foil-dot:hover {
    transform: scale(1.2);
  }
</style>
