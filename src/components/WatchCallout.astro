---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const watchInquiryUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.salesOfficers[1].phone,
  "Assalam-o-Alaikum, I would like to inquire about watch box designs, availability, and custom branding from Soobee's Box."
);
---

<section class="watch-section" id="watches" aria-label="Watch Packaging Solutions">
  <div class="container">
    <div class="watch-inner animate-in">

      <!-- Left: Content -->
      <div class="watch-content">
        <p class="section-eyebrow">Complete Packaging Portfolio</p>
        <h2 class="watch-title">Jewelry and Watch Boxes<br>Under One Roof</h2>
        <p class="watch-desc">
          Many existing clients source their jewelry boxes from us without realizing we also carry a full range of watch box designs and sizes. Single watch retail presentations, display cases, or branded timepiece collections — consolidate all packaging with one Karachi manufacturer.
        </p>

        <!-- Horizontal highlights row -->
        <div class="watch-highlights">
          <div class="highlight-item">
            <svg class="highlight-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="4" width="12" height="16" rx="6"></rect>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <div>
              <span class="highlight-label">Single &amp; Multi-Watch Profiles</span>
              <span class="highlight-sub">Square, rectangular, and cushion display formats.</span>
            </div>
          </div>
          <div class="highlight-item">
            <svg class="highlight-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
            <div>
              <span class="highlight-label">Custom Insert Configurations</span>
              <span class="highlight-sub">Watch pillow dimensions coordinated with sales officers.</span>
            </div>
          </div>
          <div class="highlight-item">
            <svg class="highlight-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <div>
              <span class="highlight-label">Logo Embossing Available</span>
              <span class="highlight-sub">Same hot-stamp foil process as jewelry packaging lines.</span>
            </div>
          </div>
        </div>

        <div class="watch-cta-row">
          <a
            href={watchInquiryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn watch-btn"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Inquire: 0333-1145556</span>
          </a>
          <p class="watch-note">Specifications coordinated directly with our dedicated sales officers for exact fit.</p>
        </div>
      </div>

      <!-- Right: Floating watch visual -->
      <div class="watch-visual" aria-hidden="true">
        <div class="watch-float-wrapper">
          <div class="wbox-outer">
            <div class="wbox-lid-hint"></div>
            <div class="wbox-inner">
              <div class="watch-pillow"></div>
              <svg width="40" height="40" viewBox="0 0 36 36" fill="none">
                <rect x="6" y="4" width="24" height="28" rx="12" stroke="#E5C37A" stroke-width="1.25" fill="none" opacity="0.7"/>
                <circle cx="18" cy="18" r="8" stroke="#E5C37A" stroke-width="1.25" fill="none" opacity="0.7"/>
                <line x1="18" y1="13" x2="18" y2="18" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round" opacity="0.9"/>
                <line x1="18" y1="18" x2="22" y2="21" stroke="#E5C37A" stroke-width="1.5" stroke-linecap="round" opacity="0.9"/>
              </svg>
            </div>
          </div>
          <p class="wbox-caption">Single watch display box</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Full dark band — dramatic page break */
  .watch-section {
    background-color: #0A0906;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  @media (min-width: 768px) {
    .watch-section {
      padding-top: 7rem;
      padding-bottom: 7rem;
    }
  }

  [data-theme="dark"] .watch-section {
    background-color: #060504;
  }

  .watch-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .watch-inner {
      grid-template-columns: 1fr auto;
      gap: 6rem;
    }
  }

  /* Eyebrow — inverted */
  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--foil-gold);
    margin-bottom: 1rem;
    opacity: 0.7;
  }

  .watch-title {
    color: #F0EDE8;
    margin-bottom: 1.25rem;
    line-height: 1.08;
  }

  .watch-desc {
    font-size: 1rem;
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.48);
    margin-bottom: 2.5rem;
    max-width: 560px;
  }

  /* Horizontal highlights */
  .watch-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 640px) {
    .watch-highlights {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    flex: 1;
  }

  .highlight-icon {
    color: var(--foil-gold);
    opacity: 0.6;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .highlight-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #E8E4DC;
    margin-bottom: 0.25rem;
  }

  .highlight-sub {
    display: block;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.38);
    line-height: 1.5;
  }

  .watch-cta-row {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
  }

  /* Inverted gold button */
  .watch-btn {
    background-color: var(--foil-gold);
    color: #0A0906;
    border: none;
    font-weight: 700;
    transition: all var(--duration-normal) var(--ease-spring);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .watch-btn:hover {
    background-color: #F5DFA0;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px rgba(229, 195, 122, 0.25);
  }

  .watch-note {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    line-height: 1.5;
    max-width: 380px;
  }

  /* Floating watch box */
  .watch-visual {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .watch-float-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    animation: float-watch 4s ease-in-out infinite;
  }

  .wbox-outer {
    width: 160px;
    height: 160px;
    background-color: #141210;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(229, 195, 122, 0.12);
    box-shadow:
      0 0 0 1px rgba(229, 195, 122, 0.06),
      0 24px 64px rgba(0, 0, 0, 0.6);
    position: relative;
    overflow: hidden;
  }

  /* Subtle lid crease */
  .wbox-lid-hint {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(229, 195, 122, 0.08);
    pointer-events: none;
  }

  .wbox-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .watch-pillow {
    width: 70px;
    height: 22px;
    background: linear-gradient(180deg, #2A2520 0%, #1A1510 100%);
    border-radius: 50%;
    border: 1px solid rgba(229, 195, 122, 0.1);
  }

  .wbox-caption {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.25);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-body);
  }
</style>
