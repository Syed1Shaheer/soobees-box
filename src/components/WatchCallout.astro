---
import { BUSINESS_INFO, createWhatsAppUrl } from '../data/products';

const watchInquiryUrl = createWhatsAppUrl(
  BUSINESS_INFO.contacts.salesOfficers[1].phone,
  "Assalam-o-Alaikum, I would like to inquire about watch box designs, availability, and custom branding from Soobee's Box."
);
---

<section class="watch-section section-spacing" id="watches" aria-label="Watch Packaging Solutions">
  <div class="container">
    <div class="watch-banner surface-card animate-in">
      <div class="watch-banner-content">
        <div class="watch-badge-group">
          <span class="badge badge-gold">Complete Packaging Portfolio</span>
          <span class="badge badge-neutral">Cross-Category Supply</span>
        </div>

        <h2 class="watch-title">Jewelry and Watch Packaging Under One Roof</h2>

        <p class="watch-description">
          Many existing clients source their jewelry boxes from us without realizing we also carry a <strong>full range of watch box designs and sizes</strong>. From single watch retail presentations to branded timepiece collections, you can consolidate all horological and jewelry packaging with a single Karachi manufacturer.
        </p>

        <div class="watch-highlights">
          <div class="highlight-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="highlight-icon">
              <circle cx="12" cy="12" r="7"></circle>
              <polyline points="12 9 12 12 13.5 13.5"></polyline>
              <path d="M16.51 17.35l-.35 3.83a2 2 0 0 1-2 1.82H9.83a2 2 0 0 1-2-1.82l-.35-3.83m.01-10.7l.35-3.83A2 2 0 0 1 9.83 1h4.35a2 2 0 0 1 2 1.82l.35 3.83"></path>
            </svg>
            <div>
              <strong>Multiple Watch Box Profiles</strong>
              <span>Square, rectangular, and display box formats for retail and ecommerce.</span>
            </div>
          </div>

          <div class="highlight-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="highlight-icon">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <div>
              <strong>Custom Timepiece Branding</strong>
              <span>Emboss your watch brand or boutique insignia on watch box covers.</span>
            </div>
          </div>
        </div>

        <!-- Note on Catalogue Confirmation -->
        <div class="watch-transparency-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="note-icon">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <span>
            <em>Note:</em> Watch box specifications, dimensions, and customized insert configurations are coordinated directly with our dedicated sales officers to ensure exact fit for your watch models.
          </span>
        </div>

        <div class="watch-cta-wrapper">
          <a 
            href={watchInquiryUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-primary"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Inquire About Watch Packaging (0333-1145556)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .watch-section {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
  }

  .watch-banner {
    padding: 3rem 2rem;
    background: linear-gradient(140deg, #FBFBF9 0%, #F5F3ED 100%);
    border: 1px solid var(--border-medium);
    border-radius: 12px;
  }

  @media (min-width: 768px) {
    .watch-banner {
      padding: 3.5rem 3rem;
    }
  }

  .watch-banner-content {
    max-width: 860px;
  }

  .watch-badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .watch-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .watch-description {
    font-size: 1.0625rem;
    line-height: 1.68;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .watch-description strong {
    color: var(--text-primary);
  }

  .watch-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background-color: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  @media (min-width: 640px) {
    .watch-highlights {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .highlight-item {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .highlight-icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .highlight-item strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .highlight-item span {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .watch-transparency-note {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .note-icon {
    color: var(--text-muted);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .watch-cta-wrapper {
    display: flex;
  }
</style>
