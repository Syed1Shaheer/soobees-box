---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Soobee's Box | Pakistan's Complete Jewelry & Watch Packaging Manufacturer",
  description = "Karachi-based manufacturer and supplier of velvet jewelry boxes, watch packaging, and custom logo embossing. S.I.T.E. Area factory & Hyderi Gold Mark Mall outlet."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo.png" />

    <!-- Fontshare: Cormorant Garamond (display) + General Sans (body) -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=cormorant@700,600,500&f[]=general-sans@700,600,500,400&display=swap"
    />

    <!-- Prevent FOUC for dark/light mode -->
    <script is:inline>
      const savedTheme = localStorage.getItem('soobees_theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    <slot />

    <!-- Enhanced Scroll Appearance Script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Directional IntersectionObserver — supports from-left, from-right, scale-in
        const animatedElements = document.querySelectorAll('.animate-in');

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.08,
            rootMargin: '0px 0px -40px 0px'
          });

          animatedElements.forEach(el => observer.observe(el));
        } else {
          animatedElements.forEach(el => el.classList.add('is-visible'));
        }

        // Header elevation on scroll
        const header = document.querySelector('header');
        window.addEventListener('scroll', () => {
          if (window.scrollY > 20) {
            header?.classList.add('header-scrolled');
          } else {
            header?.classList.remove('header-scrolled');
          }
        }, { passive: true });
      });
    </script>
  </body>
</html>
